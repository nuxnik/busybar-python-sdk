#!/bin/bash

#
# Generate the busy bar SDK from the OPENAPI openapi.yaml spec
#
docker run --rm \
    -v $PWD:/build openapitools/openapi-generator-cli generate \
    -i /build/openapi.yaml \
    -g python-pydantic-v1 \
    -o /build \
    --additional-properties=packageVersion=0.0.1 \
    --additional-properties=packageName=busybar_python_sdk,projectName=busybar-python-sdk,packageVersion=0.0.1,packageUrl=https://github.com/nuxnik/busybar-python-sdk

